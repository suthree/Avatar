# Avatar LLM TOML config example
# Copy to mykey.toml and fill real credentials.

[mixin_config]
llm_nos = ["gpt-native"]
max_retries = 2
base_delay = 0.5

[native_oai_config]
name = "gpt-native"
apikey = "PLACEHOLDER_SET_REAL_KEY"
apibase = "https://api.openai.com/v1"
# model controls the model id only; reasoning_effort controls reasoning depth.
model = "gpt-5.5"
api_mode = "chat_completions"
reasoning_effort = "xhigh"
max_retries = 1
connect_timeout = 10
read_timeout = 30
