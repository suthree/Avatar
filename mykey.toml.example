# Jarvis TOML config example
# Copy to mykey.toml and fill real credentials.

[mixin_config]
llm_nos = ["gpt-native"]
max_retries = 2
base_delay = 0.5

[native_oai_config]
name = "gpt-native"
apikey = "PLACEHOLDER_SET_REAL_KEY"
apibase = "https://api.openai.com/v1"
model = "gpt-5.4"
api_mode = "chat_completions"
max_retries = 1
connect_timeout = 10
read_timeout = 30
